doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        .container
            h1 Custom Objects
            
            a(href="/update-cobj") ➕ Add to this table
            
            .table-wrapper
                table
                    thead
                        tr
                            th Name
                            th Actor Name
                            th Superhero Name
                    tbody
                        each obj in data
                            tr
                                td #{obj.properties.name}
                                td #{obj.properties.actor_name}
                                td #{obj.properties.superhero_name}
